{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trackdexer Decision Entry",
  "type": "object",
  "required": ["id", "date", "tags", "decision"],
  "properties": {
    "id": { "type": "integer", "description": "Sequential, auto-incremented, never reused." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD." },
    "type": { "type": "string", "description": "Entry type: decision, finding, etc." },
    "commits": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "Canonical tagdexer tags from aliases.json." },
    "decision": { "type": "string" },
    "intent": { "type": "string", "description": "Why this decision matters. Required." },
    "context": { "type": "string" },
    "alternatives_rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "reason"],
        "properties": { "option": { "type": "string" }, "reason": { "type": "string" } }
      }
    },
    "constraints": { "type": "string" },
    "consequence": { "type": "string" },
    "files_affected": { "type": "array", "items": { "type": "string" }, "description": "Relative paths from repo root." },
    "supersedes": { "type": "array", "items": { "type": "integer" }, "description": "IDs of entries this one replaces." }
  },
  "additionalProperties": false
}
