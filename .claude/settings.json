{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "taskboard/hooks/taskboard_awareness.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "taskboard/hooks/taskboard_nudge.sh"
          }
        ]
      }
    ]
  }
}
